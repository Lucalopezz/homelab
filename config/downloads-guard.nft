# Tabela exclusiva. Não limpar tabelas de Docker, firewalld ou libvirt.
destroy table inet lab_download_guard
table inet lab_download_guard {
  set internos_v4 {
    type ipv4_addr
    flags interval
    elements = {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24,
      192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15,
      198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4
    }
  }
  chain entrada_host {
    type filter hook input priority -10; policy accept;
    iifname "virbr-dl" meta nfproto ipv6 counter drop
    iifname "virbr-dl" ct state established,related accept
    iifname "virbr-dl" udp sport 68 udp dport 67 accept
    iifname "virbr-dl" ip daddr 192.168.250.1 udp dport 53 accept
    iifname "virbr-dl" ip daddr 192.168.250.1 tcp dport 53 accept
    # Exceção autorizada para autenticação/catálogo do Seerr no Jellyfin.
    iifname "virbr-dl" ip saddr 192.168.250.10 ip daddr 192.168.250.1 tcp dport 8096 counter accept
    iifname "virbr-dl" counter drop
  }
  chain encaminhamento {
    type filter hook forward priority -10; policy accept;
    iifname "virbr-dl" meta nfproto ipv6 counter drop
    # A porta publicada do Jellyfin pode sofrer DNAT antes de forward.
    iifname "virbr-dl" ip saddr 192.168.250.10 ct original ip daddr 192.168.250.1 ct original proto-dst 8096 tcp dport 8096 counter accept
    iifname "virbr-dl" ip daddr @internos_v4 counter drop
    oifname "virbr-dl" ct state established,related accept
    oifname "virbr-dl" counter drop
  }
}
