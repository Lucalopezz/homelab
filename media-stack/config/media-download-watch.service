[Unit]
Description=Marcar e pausar downloads sem progresso por quinze minutos
After=qbittorrent-nox@torrent.service

[Service]
Type=oneshot
User=triagem
Group=triagem
StateDirectory=media-download-watch
StateDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/media-stack/download-watch.py
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=192.168.250.10/32
MemoryMax=96M
TimeoutStartSec=120

